# Project GRID environment template.
# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# Every variable read by src/grid/config.py must be documented here —
# enforced by scripts/check_context.py (check 12).

# ---------------------------------------------------------------------------
# Docker compose (database container bootstrap — compose.yaml)
# ---------------------------------------------------------------------------
POSTGRES_USER=grid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grid

# ---------------------------------------------------------------------------
# Application settings (GRID_ prefix, read by src/grid/config.py)
# ---------------------------------------------------------------------------

# SQLAlchemy connection URL for the warehouse (psycopg v3 driver).
GRID_DATABASE_URL=postgresql+psycopg://grid:change-me@localhost:5432/grid

# Google Maps Platform API key. Used only by src/grid/enrich/ (Places enrichment).
# Guardrail: GRID persists place_id only — no other Places content is cached.
GRID_GOOGLE_MAPS_API_KEY=

# FastAPI bind address/port (dev server).
GRID_API_HOST=127.0.0.1
GRID_API_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR
GRID_LOG_LEVEL=INFO

# Runtime environment: dev | prod (prod switches structlog to JSON output).
GRID_ENVIRONMENT=dev

# HARD GATE — outreach send capability. Must remain false until PMCare
# compliance sign-off (docs/context/compliance-outreach.md). Default false.
GRID_OUTREACH_SEND_ENABLED=false

# Secret key for the HMAC-SHA256 hash of DOCTOR_NAME (PDPA 2010 pseudonymisation).
# The salt MUST live outside the repository — set it in .env only, never here.
# grid.pr001.pdpa raises MissingSaltError rather than hash with an empty key.
# Rotating this value invalidates every existing doctor_name_hash.
GRID_PII_HASH_SALT=
